<Application x:Class="CleanStats.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Application.Resources>
        <!-- Paleta -->
        <SolidColorBrush x:Key="Fondo" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="Tarjeta" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="TarjetaBorde" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="Plata" Color="#C0C0C0"/>
        <SolidColorBrush x:Key="PlataTenue" Color="#8C8C8C"/>
        <SolidColorBrush x:Key="Rojo" Color="#E10600"/>
        <SolidColorBrush x:Key="RojoClaro" Color="#FF3B30"/>
        <SolidColorBrush x:Key="RojoSuave" Color="#33E10600"/>

        <DropShadowEffect x:Key="SombraTarjeta" BlurRadius="18" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
        <DropShadowEffect x:Key="ResplandorRojo" BlurRadius="22" ShadowDepth="0" Opacity="0.55" Color="#E10600"/>

        <!-- Barra de progreso con degradado rojo -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="7" Background="#1A1A1A"
                      BorderBrush="#3A3A3A" BorderThickness="1"/>
                            <Border x:Name="PART_Indicator" CornerRadius="7" HorizontalAlignment="Left"
                      Margin="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#E10600" Offset="0"/>
                                        <GradientStop Color="#FF5A3C" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón píldora rojo principal -->
        <Style x:Key="BotonRojo" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Effect" Value="{StaticResource ResplandorRojo}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="14" Background="#E10600">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3B30"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B30500"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón píldora contorno plata -->
        <Style x:Key="BotonContorno" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Plata}"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="14" Background="#2A2A2A"
                    BorderBrush="#4A4A4A" BorderThickness="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C0C0C0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón píldora pequeño (Cambiar carpeta) -->
        <Style x:Key="BotonChico" TargetType="Button" BasedOn="{StaticResource BotonContorno}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <!-- Interruptor rojo -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Plata}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Pista" Width="46" Height="26" CornerRadius="13"
                      Background="#3A3A3A" BorderThickness="1" BorderBrush="#4A4A4A">
                                <Ellipse x:Name="Bola" Width="18" Height="18" Fill="#8C8C8C"
                         HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                            <ContentPresenter Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pista" Property="Background" Value="#E10600"/>
                                <Setter TargetName="Pista" Property="BorderBrush" Value="#E10600"/>
                                <Setter TargetName="Bola" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Bola" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Etiqueta de categoría -->
        <Style x:Key="EtiquetaCat" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ReadableCategory}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ReadableCategory}" Value="Temporal">
                    <Setter Property="Background" Value="#B03140"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ReadableCategory}" Value="Log">
                    <Setter Property="Background" Value="#B0A131"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ReadableCategory}" Value="Cache">
                    <Setter Property="Background" Value="#B06131"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ReadableCategory}" Value="Dump">
                    <Setter Property="Background" Value="#31B0A1"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ReadableCategory}" Value="Otro">
                    <Setter Property="Background" Value="#3140B0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EtiquetaCatTexto" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Plata}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ReadableCategory}" Value="Temporal">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ReadableCategory}" Value="Log">
                    <Setter Property="Foreground" Value="#181900"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ReadableCategory}" Value="Cache">
                    <Setter Property="Foreground" Value="#181900"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ReadableCategory}" Value="Dump">
                    <Setter Property="Foreground" Value="#181900"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ReadableCategory}" Value="Otro">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EtiquetaStatus" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ReadableStatus}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ReadableStatus}" Value="Sin clasificar">
                    <Setter Property="Background" Value="#F52738"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ReadableStatus}" Value="Clasificado">
                    <Setter Property="Background" Value="#079C14"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ReadableStatus}" Value="Pendiente de revisión">
                    <Setter Property="Background" Value="#27A9F5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EtiquetaStatTexto" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Plata}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ReadableStatus}" Value="Sin clasificar">
                    <Setter Property="Foreground" Value="#181900"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ReadableStatus}" Value="Clasificado">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ReadableStatus}" Value="Pendiente de revisión">
                    <Setter Property="Foreground" Value="#181900"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CleanScrollBar" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                           IsDirectionReversed="True">

                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Background="#626262"
                                                CornerRadius="4"
                                                Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>

                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabCard" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Franja de pestañas -->
                            <Border Panel.ZIndex="1" HorizontalAlignment="Left" Margin="0,0,0,-2">
                                <TabPanel IsItemsHost="True" Margin="8,0"/>
                            </Border>

                            <!-- Contenido: tarjeta carbón con borde y sombra -->
                            <Border Grid.Row="1" Background="{StaticResource Tarjeta}"
                    CornerRadius="18" BorderBrush="{StaticResource TarjetaBorde}"
                    BorderThickness="1" Effect="{StaticResource SombraTarjeta}">
                                <ContentPresenter ContentSource="SelectedContent" Margin="20,18"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== Pestaña tipo píldora ===================== -->
        <Style x:Key="TabPill" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource PlataTenue}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" CornerRadius="12" Padding="18,10" Margin="0,0,8,0"
                  Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tarjeta}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource TarjetaBorde}"/>
                                <Setter Property="Foreground" Value="{StaticResource Plata}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RojoSuave}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Rojo}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="Bd" Property="Effect" Value="{StaticResource ResplandorRojo}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== Pestaña con línea roja ===================== -->
        <Style x:Key="TabLinea" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource PlataTenue}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="18,10" Margin="0,0,6,0"
                  CornerRadius="12,12,0,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#242424"/>
                                <Setter Property="Foreground" Value="{StaticResource Plata}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tarjeta}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Rojo}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== TabControl variante con pestañas de línea ===================== -->
        <!-- Pestañas pegadas al borde superior de la tarjeta (pestañas integradas) -->
        <Style x:Key="TabCardLinea" TargetType="TabControl" BasedOn="{StaticResource TabCard}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="1" Background="{StaticResource Tarjeta}"
                    CornerRadius="18" BorderBrush="{StaticResource TarjetaBorde}"
                    BorderThickness="1" Effect="{StaticResource SombraTarjeta}">
                                <ContentPresenter ContentSource="SelectedContent" Margin="20,18"/>
                            </Border>
                            <Border Panel.ZIndex="1" HorizontalAlignment="Left" Margin="10,0,0,0">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
