<Window x:Class="CleanStats.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanStats" Height="520" Width="900"
        MinHeight="420" MinWidth="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="CleanStats" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,8,0,20" Foreground="Gray"
                   Text="Analizador local de almacenamiento · etapa inicial de desarrollo" />
        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Base de la aplicación creada" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="Esta versión es únicamente el esqueleto de la interfaz. Todavía no analiza, clasifica, modifica ni elimina archivos." />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="La siguiente etapa incorporará los modelos y contratos del escaneo; el escáner se implementará después de validar esta base." />
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="3" Margin="0,16,0,0" Foreground="Gray"
                   Text="Modo actual: sin acceso de escritura al sistema de archivos." />
    </Grid>
</Window>
