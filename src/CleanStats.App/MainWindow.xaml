<Window x:Class="CleanStats.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanStats" Width="1100" Height="760"
        WindowStartupLocation="CenterScreen" Background="#1F1F1F"
        FontFamily="Segoe UI" Foreground="#C0C0C0">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,24,26,20">
            <DockPanel  VerticalAlignment="Center">
                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource Rojo}">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CleanStats" FontSize="22" FontWeight="Bold"
                     Foreground="#FFFFFF"/>
                    <TextBlock Text="Analiza archivos sin modificar el sistema"
                     FontSize="12" Foreground="{StaticResource PlataTenue}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Width="100" Height="20" CornerRadius="5" Background="{StaticResource Rojo}" DockPanel.Dock="Right">
                    <TextBlock Text="Escaneo local" FontSize="13" FontWeight="Bold" Foreground="White"  Padding="2" TextAlignment="Center"/>
                </Border>
            </DockPanel>

            <!-- Tarjeta: ubicación -->
            <Border Background="{StaticResource Tarjeta}" CornerRadius="18"
              BorderBrush="{StaticResource TarjetaBorde}" BorderThickness="1"
              Effect="{StaticResource SombraTarjeta}" Margin="0,22,0,0" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="UBICACIÓN DEL ESCANEO" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource PlataTenue}"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource RojoSuave}">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                         Foreground="{StaticResource RojoClaro}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Carpeta seleccionada" FontSize="11"
                         Foreground="{StaticResource PlataTenue}"/>
                            <TextBlock x:Name="TxtRuta" Text="C:\Users\Usuario" FontFamily="Consolas"
                         FontSize="14" Foreground="{StaticResource Plata}"
                         TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource BotonChico}" Content="Cambiar"
                    VerticalAlignment="Center" Margin="12,0,0,0"
                    ToolTip="Elegir carpeta" x:Name="BtnCambiarRuta" Click="BtnCambiarRuta_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource Tarjeta}" CornerRadius="18"
              BorderBrush="{StaticResource TarjetaBorde}" BorderThickness="1"
              Effect="{StaticResource SombraTarjeta}" Margin="0,14,0,0" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="OPCIONES" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource PlataTenue}"/>
                    <CheckBox x:Name="ChkOcultos" Style="{StaticResource Toggle}"
                    Content="Incluir archivos y directorios ocultos" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource Tarjeta}" CornerRadius="18"
              BorderBrush="{StaticResource TarjetaBorde}" BorderThickness="1"
              Effect="{StaticResource SombraTarjeta}" Margin="0,14,0,0" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="PROGRESO DEL ESCANEO" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource PlataTenue}"/>

                    <UniformGrid Columns="3" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                         Foreground="{StaticResource RojoClaro}"/>
                            <TextBlock x:Name="TxtEncontrados" Text="0" FontSize="26" FontWeight="Light"
                         Foreground="#FFFFFF" Margin="0,6,0,0"/>
                            <TextBlock Text="Encontrados" FontSize="11"
                         Foreground="{StaticResource PlataTenue}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                         Foreground="{StaticResource Plata}"/>
                            <TextBlock x:Name="TxtProcesados" Text="0" FontSize="26" FontWeight="Light"
                         Foreground="#FFFFFF" Margin="0,6,0,0"/>
                            <TextBlock Text="Procesados" FontSize="11"
                         Foreground="{StaticResource PlataTenue}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                         Foreground="{StaticResource Plata}"/>
                            <TextBlock x:Name="TxtErrores" Text="0" FontSize="26" FontWeight="Light"
                         Foreground="{StaticResource RojoClaro}" Margin="0,6,0,0"/>
                            <TextBlock Text="Con errores" FontSize="11"
                         Foreground="{StaticResource PlataTenue}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
            <!-- Tarjeta: archivos analizados -->
            <Border Background="{StaticResource Tarjeta}" CornerRadius="18"
              BorderBrush="{StaticResource TarjetaBorde}" BorderThickness="1"
              Effect="{StaticResource SombraTarjeta}" Margin="0,14,0,0" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="ARCHIVOS ANALIZADOS" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource PlataTenue}"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Archivos procesados" FontSize="12"
                       Foreground="{StaticResource PlataTenue}"/>
                        <TextBlock Text="Clasificación" FontSize="12" Grid.Column="1"
                       Foreground="{StaticResource PlataTenue}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Height="1" Background="{StaticResource TarjetaBorde}" Margin="0,12,0,0"/>

                    <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CleanScrollBar}"/>
                        </ScrollViewer.Resources>
                        <ItemsControl x:Name="ListaArchivos">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Text="{Binding FilePath}"
                                               FontSize="11"
                                               FontFamily="Consolas"
                                               Foreground="{StaticResource PlataTenue}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                            Style="{StaticResource EtiquetaCat}"
                                            Margin="12,0,0,0" Padding="5">
                                            <TextBlock Style="{StaticResource EtiquetaCatTexto}" Text="{Binding Category}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="TxtNotaLista" FontSize="11" TextWrapping="Wrap"
                     Foreground="{StaticResource PlataTenue}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>


            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnIniciar" Style="{StaticResource BotonRojo}" Click="BtnIniciar_Click" >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                       VerticalAlignment="Center"/>
                        <TextBlock Text="Iniciar escaneo" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnCancelar" Grid.Column="2" Style="{StaticResource BotonContorno}"
                IsEnabled="False" Click="BtnCancelar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                       VerticalAlignment="Center"/>
                        <TextBlock Text="Cancelar" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0" HorizontalAlignment="Center">
                <Ellipse x:Name="PuntoEstado" Width="8" Height="8" Fill="#C0C0C0"
                 VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtEstado" Text="Listo para escanear." FontSize="12"
                   Foreground="{StaticResource PlataTenue}" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
